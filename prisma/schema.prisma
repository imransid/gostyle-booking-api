// Go Style Booking: core schema (Step 2)
// Everything the confirm transaction touches on the happy path.
//
// Two things Prisma cannot express live in prisma/migrations/ as raw SQL:
//   1. EXCLUDE USING gist  (the anti-double-booking guarantee)
//   2. CHECK constraints   (sanity rules on money and time)
// Never let a `migrate dev` drop them.

// Prisma 7: the connection url lives in prisma.config.ts, not here.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // REQUIRED. Prisma 7 generates ESM by default, and NestJS compiles to
  // CommonJS. Without this, the app boots under ts-node but dies under
  // plain node with "exports is not defined in ES module scope".
  moduleFormat = "cjs"
  // Bare specifiers: "./internal/class", not "./internal/class.ts".
  //
  // tsc NEVER rewrites import specifiers. With the default of "ts",
  // the generated source says "./internal/class.ts" and the compiled
  // .js still says it, so node looks for a .ts file that was compiled
  // away. Bare specifiers resolve to .ts at compile time and .js at
  // runtime, which is the classic CommonJS arrangement.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ============================================================ enums

enum BookingStatus {
  draft
  held
  pending_payment
  pending_confirmation
  confirmed
  checked_in
  in_service
  completed
  settled
  cancelled
  no_show
  rescheduled
  expired
  skipped

  @@map("booking_status")
}

enum PaymentStatus {
  none_required
  unpaid
  deposit_paid
  fully_paid
  partially_refunded
  refunded
  forfeited
  settled

  @@map("payment_status")
}

enum SegmentKind {
  setup
  active
  processing
  finishing
  teardown

  @@map("segment_kind")
}

// ============================================================ booking

model Booking {

  /// WHO THIS ROW BELONGS TO, captured and not yet enforced.
  ///
  /// Stamped from the X-Tenant-Id header on the way in (falling back to the
  /// tenantId claim on the staff token). NOTHING FILTERS ON IT YET, and that
  /// is deliberate: a filter added before every row carries a value silently
  /// hides the rows written without one. Backfill first, then filter, then
  /// make it NOT NULL -- in that order, and each step observable.
  tenantId String? @map("tenant_id")
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  // External ids. No FK: these rows live in other services.
  branchId   String @map("branch_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  status        BookingStatus @default(draft)
  paymentStatus PaymentStatus @default(none_required) @map("payment_status")

  // Time, stored twice on purpose.
  // start_at/end_at  -> Postgres, for the overlap constraint
  // start_minute     -> the kernel, minutes from midnight (900 = 15:00)
  tradingDay  DateTime @map("trading_day") @db.Date
  startAt     DateTime @map("start_at") @db.Timestamptz(6)
  endAt       DateTime @map("end_at") @db.Timestamptz(6)
  startMinute Int      @map("start_minute") @db.SmallInt
  durationMin Int      @map("duration_min") @db.SmallInt

  // Money as whole fils. Never Decimal, never Float.
  priceFils         Int     @default(0) @map("price_fils")
  depositFils       Int     @default(0) @map("deposit_fils")
  requirementSource String? @map("requirement_source")

  channel        String
  moveCount      Int     @default(0) @map("move_count") @db.SmallInt
  overbooked     Boolean @default(false)
  overbookReason String? @map("overbook_reason")

  /// The payment link window. Set when a booking is confirmed on the link
  /// rail; null on every other rail. An unpaid link holds a professional and
  /// a chair exactly as a confirmed booking does, so it needs a closing time.
  /// Set when this booking is one participant's lane in a group.
  groupId String? @map("group_id") @db.Uuid

  linkExpiresAt  DateTime? @map("link_expires_at") @db.Timestamptz(6)
  linkRemindedAt DateTime? @map("link_reminded_at") @db.Timestamptz(6)

  // The reminder ladder. Timestamps rather than booleans: "when did we tell
  // them" is the question support actually asks, and a boolean cannot answer
  // it. NULL means outstanding, and that is what the scheduler claims on.
  reminded24hAt DateTime? @map("reminded_24h_at") @db.Timestamptz(6)
  reminded3hAt  DateTime? @map("reminded_3h_at") @db.Timestamptz(6)
  nudged15mAt   DateTime? @map("nudged_15m_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items           BookingItem[]
  ledger          DepositLedger[]
  statusHistory   BookingStatusHistory[]
  idempotencyKeys IdempotencyKey[]

  @@index([branchId, tradingDay, status], map: "booking_branch_day_idx")
  @@index([customerId, startAt(sort: Desc)], map: "booking_customer_idx")
  @@map("booking")
}

// ============================================================ booking_item

model BookingItem {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // The snapshot. The catalogue can change; this cannot.
  serviceId     String @map("service_id") @db.Uuid
  serviceName   String @map("service_name")
  resourceType  String @map("resource_type")
  requiredSkill String @map("required_skill")

  priceFils   Int @map("price_fils")
  durationMin Int @map("duration_min") @db.SmallInt
  position    Int @db.SmallInt

  staffId String @map("staff_id") @db.Uuid

  staffReservations    StaffReservation[]
  resourceReservations ResourceReservation[]

  @@unique([bookingId, position])
  @@index([bookingId], map: "booking_item_booking_idx")
  @@map("booking_item")
}

// ============================================================ hold

model Hold {
  id         String  @id @default(uuid()) @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  tradingDay       DateTime @map("trading_day") @db.Date
  feasibilityToken String   @map("feasibility_token")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  staffReservations    StaffReservation[]
  resourceReservations ResourceReservation[]

  @@index([expiresAt], map: "hold_expiry_idx")
  @@map("hold")
}

// ============================================================ staff_reservation
// ONE table for booked segments AND held segments, so ONE constraint
// protects both. A held slot is not sellable to anyone else.

model StaffReservation {
  id String @id @default(uuid()) @db.Uuid

  // Exactly one of these is set. Enforced by a CHECK in raw SQL.
  bookingItemId String?      @map("booking_item_id") @db.Uuid
  bookingItem   BookingItem? @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  holdId        String?      @map("hold_id") @db.Uuid
  hold          Hold?        @relation(fields: [holdId], references: [id], onDelete: Cascade)

  branchId   String   @map("branch_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  tradingDay DateTime @map("trading_day") @db.Date

  kind        SegmentKind
  startAt     DateTime    @map("start_at") @db.Timestamptz(6)
  endAt       DateTime    @map("end_at") @db.Timestamptz(6)
  startMinute Int         @map("start_minute") @db.SmallInt
  durationMin Int         @map("duration_min") @db.SmallInt

  // Drives the exclusion constraint. False means capacity is released.
  blocking Boolean @default(true)

  claimPreMin  Int @default(0) @map("claim_pre_min") @db.SmallInt
  claimPostMin Int @default(0) @map("claim_post_min") @db.SmallInt

  /**
   * Hands-free band, so the carve-back survives a round trip.
   */
  processingFromMin Int? @map("processing_from_min") @db.SmallInt
  processingToMin   Int? @map("processing_to_min") @db.SmallInt

  @@index([branchId, tradingDay, staffId], map: "staff_res_day_idx")
  @@map("staff_reservation")
}

// ============================================================ resource_reservation
// Chairs have capacity (2 colour stations), so overlap is legal up to the
// unit count. Counted under an advisory lock. Once a concrete unit is
// pinned at check-in, exclusion applies to that unit.

model ResourceReservation {
  id String @id @default(uuid()) @db.Uuid

  bookingItemId String?      @map("booking_item_id") @db.Uuid
  bookingItem   BookingItem? @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  holdId        String?      @map("hold_id") @db.Uuid
  hold          Hold?        @relation(fields: [holdId], references: [id], onDelete: Cascade)

  branchId       String  @map("branch_id") @db.Uuid
  resourceType   String  @map("resource_type")
  resourceUnitId String? @map("resource_unit_id") @db.Uuid

  tradingDay  DateTime @map("trading_day") @db.Date
  startAt     DateTime @map("start_at") @db.Timestamptz(6)
  endAt       DateTime @map("end_at") @db.Timestamptz(6)
  startMinute Int      @map("start_minute") @db.SmallInt
  durationMin Int      @map("duration_min") @db.SmallInt

  blocking Boolean @default(true)

  @@index([branchId, tradingDay, resourceType], map: "resource_res_day_idx")
  @@map("resource_reservation")
}

// ============================================================ STEP 3
// Money, audit, delivery, retry safety.

enum LedgerEntryType {
  captured
  applied_at_pos
  refunded
  partially_refunded
  forfeited
  reversed
  goodwill
  course_draw

  @@map("ledger_entry_type")
}

enum PaymentRail {
  wallet
  card
  apple_pay
  cash
  link
  internal

  @@map("payment_rail")
}

enum ActorKind {
  customer
  staff
  manager
  system

  @@map("actor_kind")
}

// Append-only, enforced by a database trigger.
// Signed amounts, so a booking's protected balance is SUM(amountFils).
model DepositLedger {
  id        String  @id @default(uuid(7)) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  entryType  LedgerEntryType @map("entry_type")
  amountFils Int             @map("amount_fils")

  rail             PaymentRail?
  gatewayRef       String?      @map("gateway_ref")
  posTransactionId String?      @map("pos_transaction_id")

  // A reversal or partial refund names the row it corrects.
  linkedEntryId String?         @map("linked_entry_id") @db.Uuid
  linkedEntry   DepositLedger?  @relation("LedgerCorrection", fields: [linkedEntryId], references: [id], onDelete: Restrict)
  corrections   DepositLedger[] @relation("LedgerCorrection")

  reason    String?
  actorKind ActorKind @map("actor_kind")
  actorId   String?   @map("actor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bookingId, createdAt], map: "deposit_ledger_booking_idx")
  @@map("deposit_ledger")
}

// Append-only. Every transition, with who did it and why.
model BookingStatusHistory {
  id        String  @id @default(uuid(7)) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")

  reason   String?
  metadata Json?

  actorKind ActorKind @map("actor_kind")
  actorId   String?   @map("actor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bookingId, createdAt], map: "booking_status_history_booking_idx")
  @@map("booking_status_history")
}

// Written INSIDE the same transaction as the state change, so an event
// can never be lost when Redis is down.
model EventOutbox {
  id String @id @default(uuid(7)) @db.Uuid

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id") @db.Uuid
  eventType     String @map("event_type")
  payload       Json

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0) @db.SmallInt
  lastError   String?   @map("last_error")

  @@index([aggregateType, aggregateId], map: "event_outbox_aggregate_idx")
  @@map("event_outbox")
}

// A retried request returns the original result instead of charging twice.
model IdempotencyKey {
  key         String @id
  operation   String
  requestHash String @map("request_hash")

  responseStatus Int?  @map("response_status") @db.SmallInt
  responseBody   Json? @map("response_body")

  bookingId String?  @map("booking_id") @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idempotency_key_expiry_idx")
  @@map("idempotency_key")
}

// ============================================================ waitlist
// What turns a cancellation into revenue rather than a hole in the day.

enum WaitlistStatus {
  waiting
  offered
  accepted
  expired
  left

  @@map("waitlist_status")
}

model WaitlistEntry {

  /// WHO THIS ROW BELONGS TO, captured and not yet enforced.
  ///
  /// Stamped from the X-Tenant-Id header on the way in (falling back to the
  /// tenantId claim on the staff token). NOTHING FILTERS ON IT YET, and that
  /// is deliberate: a filter added before every row carries a value silently
  /// hides the rows written without one. Backfill first, then filter, then
  /// make it NOT NULL -- in that order, and each step observable.
  tenantId String? @map("tenant_id")
  id String @id @default(uuid()) @db.Uuid

  branchId   String @map("branch_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  serviceId  String @map("service_id")

  tradingDay    DateTime @map("trading_day") @db.Date
  windowFromMin Int      @map("window_from_min") @db.SmallInt
  windowToMin   Int      @map("window_to_min") @db.SmallInt

  /// null means "any professional".
  preferredStaffId String? @map("preferred_staff_id") @db.Uuid

  status WaitlistStatus @default(waiting)

  /// The fairness cap. Three declines and offers stop for this window.
  declineCount Int @default(0) @map("decline_count") @db.SmallInt

  /// Booking codes already turned down, so a slot is never offered twice.
  declinedCodes String[] @default([]) @map("declined_codes")

  /// The live offer, if any. Cleared when it is accepted, declined or lapses.
  ///
  /// THE SLOT IS STORED, NOT DERIVED. The code alone used to be enough: the
  /// slot was read back off the booking row, which for a cancel or a no-show
  /// still sits exactly where it was freed. A RESCHEDULE moves that row. The
  /// offer then described the slot the booking had moved INTO -- occupied,
  /// by that same booking -- and accept answered 409 every time. Keeping the
  /// slot as it was at the moment it was offered is the only version that
  /// survives the booking changing afterwards.
  offeredBookingCode String?   @map("offered_booking_code")
  offerExpiresAt     DateTime? @map("offer_expires_at") @db.Timestamptz(6)
  offeredStartMin    Int?      @map("offered_start_min") @db.SmallInt
  offeredDurationMin Int?      @map("offered_duration_min") @db.SmallInt
  offeredStaffId     String?   @map("offered_staff_id") @db.Uuid

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  // The matching query: one day, one service, still waiting. Partial on the
  // live statuses, because a list that has been served is dead weight and an
  // index over every entry ever created would grow without bound.
  @@index([branchId, tradingDay, serviceId], map: "waitlist_match_idx")
  @@index([offerExpiresAt], map: "waitlist_offer_expiry_idx")
  @@map("waitlist_entry")
}

// ============================================================ groups
// A parent reservation holding two or more participants, each with their own
// items, professional, chair and status, unified by one organiser, one target
// window and one payment arrangement.

enum GroupMode {
  arrive_together
  finish_together

  @@map("group_mode")
}

enum GroupArrangement {
  organiser_pays_all
  split_equally
  each_pays_own

  @@map("group_arrangement")
}

model BookingGroup {

  /// WHO THIS ROW BELONGS TO, captured and not yet enforced.
  ///
  /// Stamped from the X-Tenant-Id header on the way in (falling back to the
  /// tenantId claim on the staff token). NOTHING FILTERS ON IT YET, and that
  /// is deliberate: a filter added before every row carries a value silently
  /// hides the rows written without one. Backfill first, then filter, then
  /// make it NOT NULL -- in that order, and each step observable.
  tenantId String? @map("tenant_id")
  id String @id @default(uuid()) @db.Uuid

  branchId    String @map("branch_id") @db.Uuid
  organiserId String @map("organiser_id") @db.Uuid

  tradingDay DateTime @map("trading_day") @db.Date
  /// The anchor. In arrive-together every lane starts here; in
  /// finish-together the lanes are staggered backwards to end together.
  targetMin  Int      @map("target_min") @db.SmallInt

  mode        GroupMode
  arrangement GroupArrangement

  /// Derived from the participants, never set directly. Confirmed when all
  /// active participants are confirmed, partially_confirmed while shares are
  /// pending, and so on.
  status String @default("draft")

  /// How many participants have not left.
  ///
  /// Stored because the STATUS ALONE CANNOT CARRY THE INTERESTING CHANGE.
  /// A party of three losing one is still confirmed, so a listener that only
  /// wrote on a status change stayed silent at exactly the moment the party
  /// dropped toward being a single booking. The count is what actually moved.
  activeCount Int @default(0) @map("active_count") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants GroupParticipant[]

  @@index([branchId, tradingDay], map: "group_day_idx")
  @@map("booking_group")
}

model GroupParticipant {
  id      String       @id @default(uuid()) @db.Uuid
  groupId String       @map("group_id") @db.Uuid
  group   BookingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// A registered customer, or null for a named guest under the organiser.
  /// Guests inherit the organiser's contact channel; registered participants
  /// get their own messages and their own Pass QR.
  customerId String? @map("customer_id") @db.Uuid
  guestName  String? @map("guest_name")

  /// THE LANE IS AN ORDINARY BOOKING.
  ///
  /// Check-in, no-show, settlement and the waitlist all operate on bookings,
  /// so a participant whose lane is a booking inherits every one of them.
  /// A parallel participant-lifecycle would mean writing all of that twice
  /// and keeping the two in step forever.
  bookingId String? @unique @map("booking_id") @db.Uuid

  /// What this participant owes under the arrangement. Null until the group
  /// is priced.
  shareFils Int? @map("share_fils")

  position Int @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([groupId, position], map: "participant_position_uniq")
  @@index([bookingId], map: "participant_booking_idx")
  @@map("group_participant")
}

// ============================================================ series
// A recurring booking DEFINITION and the occurrences it wants.
//
// The definition is the series. Each generated visit is an occurrence, which
// is an ordinary booking with a link back. Everything that works on a booking
// works on an occurrence unchanged.

enum RecurrencePattern {
  weekly
  every_n_weeks
  monthly_on_date
  custom

  @@map("recurrence_pattern")
}

enum SeriesEndKind {
  never
  on_date
  after_count

  @@map("series_end_kind")
}

enum AutoConfirmRule {
  auto_confirm_on_schedule
  ask_each_time
  vip_standing

  @@map("auto_confirm_rule")
}

enum SeriesStatus {
  active
  paused
  ended
  completed

  @@map("series_status")
}

enum OccurrenceState {
  /// Wanted, not yet run through the availability engine.
  planned
  /// A booking exists.
  materialised
  /// The engine could not seat it. Alternatives are attached.
  needs_attention
  /// Deliberately skipped; the series continues.
  skipped
  /// Edited with "this occurrence only". It no longer follows the series.
  detached

  @@map("occurrence_state")
}

model BookingSeries {

  /// WHO THIS ROW BELONGS TO, captured and not yet enforced.
  ///
  /// Stamped from the X-Tenant-Id header on the way in (falling back to the
  /// tenantId claim on the staff token). NOTHING FILTERS ON IT YET, and that
  /// is deliberate: a filter added before every row carries a value silently
  /// hides the rows written without one. Backfill first, then filter, then
  /// make it NOT NULL -- in that order, and each step observable.
  tenantId String? @map("tenant_id")
  id String @id @default(uuid()) @db.Uuid

  branchId   String @map("branch_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  /// The first day the series may land on. Also fixes the weekday for
  /// every_n_weeks: the weekday is NOT a second field, because two places to
  /// say which day it is means one of them eventually disagrees.
  anchorDay DateTime @map("anchor_day") @db.Date
  startMin  Int      @map("start_min") @db.SmallInt

  pattern RecurrencePattern

  /// Per-pattern payload. Exactly one shape is populated, and which one is a
  /// CHECK constraint in the migration rather than a convention.
  weekdays      Int[]      @default([]) @db.SmallInt
  intervalWeeks Int?       @map("interval_weeks") @db.SmallInt
  dayOfMonth    Int?       @map("day_of_month") @db.SmallInt
  customDates   DateTime[] @default([]) @map("custom_dates") @db.Date

  endKind  SeriesEndKind @default(never) @map("end_kind")
  endDate  DateTime?     @map("end_date") @db.Date
  endCount Int?          @map("end_count") @db.SmallInt

  autoConfirmRule AutoConfirmRule @map("auto_confirm_rule")
  status          SeriesStatus    @default(active)

  /// What the series books. Resolved per occurrence against the live
  /// catalogue; this is the definition, not the price.
  serviceId        String  @map("service_id") @db.Uuid
  preferredStaffId String? @map("preferred_staff_id") @db.Uuid

  /// The price the series was sold at. An occurrence priced differently is a
  /// change against the baseline, which the panel discloses.
  baselinePriceFils Int @default(0) @map("baseline_price_fils")

  /// Hold the baseline for this client even when the catalogue moves.
  grandfathered Boolean @default(false)

  /// How far the calendar is real. The nightly job tops this up to 70 days.
  materialisedThrough DateTime? @map("materialised_through") @db.Date

  /// A course is sold once and drawn down per visit. All three move together
  /// or none of them exist: enforced as a CHECK, not as a habit.
  courseTotalNetFils Int? @map("course_total_net_fils")
  courseVisits       Int? @map("course_visits") @db.SmallInt
  courseDrawn        Int  @default(0) @map("course_drawn") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  occurrences SeriesOccurrence[]

  @@index([branchId, anchorDay], map: "series_branch_idx")
  @@index([customerId], map: "series_customer_idx")
  @@map("booking_series")
}

model SeriesOccurrence {
  id       String        @id @default(uuid()) @db.Uuid
  seriesId String        @map("series_id") @db.Uuid
  series   BookingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// 0-based ordinal within the whole series, counted from the anchor. It is
  /// what makes "the twelfth of twenty" survive a top-up eighteen months on.
  index Int @db.SmallInt

  plannedDay      DateTime @map("planned_day") @db.Date
  plannedStartMin Int      @map("planned_start_min") @db.SmallInt

  /// The month had no such date and this fell back to the last day.
  movedFromDayOfMonth Int? @map("moved_from_day_of_month") @db.SmallInt

  state OccurrenceState @default(planned)

  /// THE OCCURRENCE IS AN ORDINARY BOOKING, exactly as a group's lane is.
  ///
  /// Null while planned, and null for needs_attention: an occurrence the
  /// engine could not seat has no slot, so it cannot be a booking without
  /// inventing start and end times it does not have.
  ///
  /// The link lives HERE and nowhere else. Recording it on booking as well
  /// would be the same fact in two tables, and the second one is the one that
  /// goes stale.
  bookingId String? @unique @map("booking_id") @db.Uuid

  /// Up to three nearest alternatives, attached when the ladder could not
  /// repair the occurrence automatically.
  alternatives Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([seriesId, index], map: "occurrence_ordinal_uniq")
  @@index([seriesId, plannedDay], map: "occurrence_series_day_idx")
  @@map("series_occurrence")
}

// ============================================================ roster changes
// A proposed roster edit, the bookings it disturbs, and the gate that stops
// it committing while any of them is unresolved.

enum RosterChangeKind {
  shift_conflict
  closure_sweep
  chair_out_of_service

  @@map("roster_change_kind")
}

enum WorklistItemState {
  open
  auto_repaired
  resolved
  overridden
  cancelled

  @@map("worklist_item_state")
}

model RosterChange {

  /// WHO THIS ROW BELONGS TO, captured and not yet enforced.
  ///
  /// Stamped from the X-Tenant-Id header on the way in (falling back to the
  /// tenantId claim on the staff token). NOTHING FILTERS ON IT YET, and that
  /// is deliberate: a filter added before every row carries a value silently
  /// hides the rows written without one. Backfill first, then filter, then
  /// make it NOT NULL -- in that order, and each step observable.
  tenantId String? @map("tenant_id")
  id String @id @default(uuid()) @db.Uuid

  branchId   String   @map("branch_id") @db.Uuid
  tradingDay DateTime @map("trading_day") @db.Date

  kind RosterChangeKind

  /// The professional going off, for a shift conflict.
  staffId String? @map("staff_id") @db.Uuid
  /// The chair type going out of service.
  resourceType String? @map("resource_type")

  reason String

  /// When the roster service told us it had committed.
  ///
  /// The GATE is not stored. "May this commit?" is computed from the items
  /// that exist, because a stored boolean and a set of item states are two
  /// facts that can disagree. What is stored is the fact that a commit
  /// happened, which nothing else can derive.
  ///
  /// A trigger refuses to set this while any item is still open. That is the
  /// commit gate, and it is a rule in the database rather than a promise the
  /// caller makes.
  committedAt DateTime? @map("committed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items RosterChangeItem[]

  @@index([branchId, tradingDay], map: "roster_change_day_idx")
  @@map("roster_change")
}

model RosterChangeItem {
  id       String       @id @default(uuid()) @db.Uuid
  changeId String       @map("change_id") @db.Uuid
  change   RosterChange @relation(fields: [changeId], references: [id], onDelete: Cascade)

  bookingId   String @map("booking_id") @db.Uuid
  bookingCode String @map("booking_code")

  state WorklistItemState @default(open)

  /// Which rung of the ladder settled it, where one did.
  rung String?

  /// The prepared salon cancellation: refund, goodwill and waitlist window.
  /// Present only while a human has yet to accept it.
  proposal Json? @db.JsonB

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([changeId, bookingId], map: "worklist_booking_uniq")
  @@index([changeId], map: "worklist_change_idx")
  @@map("roster_change_item")
}

// ============================================================ walk-ins
// People standing in the salon, in the order they arrived.

enum WalkInStatus {
  waiting
  /// Converted into a booking through the ordinary confirm path.
  seated
  /// Gave up, or was sent to the waitlist instead.
  left

  @@map("walk_in_status")
}

model WalkInEntry {

  /// WHO THIS ROW BELONGS TO, captured and not yet enforced.
  ///
  /// Stamped from the X-Tenant-Id header on the way in (falling back to the
  /// tenantId claim on the staff token). NOTHING FILTERS ON IT YET, and that
  /// is deliberate: a filter added before every row carries a value silently
  /// hides the rows written without one. Backfill first, then filter, then
  /// make it NOT NULL -- in that order, and each step observable.
  tenantId String? @map("tenant_id")
  id String @id @default(uuid()) @db.Uuid

  branchId   String   @map("branch_id") @db.Uuid
  tradingDay DateTime @map("trading_day") @db.Date

  /// A registered customer, or null for somebody who just walked in.
  customerId String? @map("customer_id") @db.Uuid
  guestName  String? @map("guest_name")

  /// What they want. Packages are expanded before they get here.
  serviceIds  String[] @map("service_ids")
  durationMin Int      @map("duration_min") @db.SmallInt

  status WalkInStatus @default(waiting)

  /// The booking they were seated into. The queue entry keeps pointing at it
  /// so "who did we seat and when" survives the day.
  bookingId String? @unique @map("booking_id") @db.Uuid

  /// The hold the desk took while walking them to a chair.
  ///
  /// Seating produces a HOLD, not a booking: the desk confirms it through the
  /// ordinary path a moment later. Remembering the hold is what lets the
  /// confirmation find its way back here, so the queue empties itself instead
  /// of relying on somebody pressing a second button.
  holdId String? @map("hold_id") @db.Uuid

  /// Minute of day they joined. THE QUEUE IS ORDERED BY THIS AND NOTHING
  /// ELSE: a salon that reorders its waiting room by service value is one
  /// where the person who has waited longest watches somebody else go first.
  joinedMin Int      @map("joined_min") @db.SmallInt
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([branchId, tradingDay], map: "walk_in_day_idx")
  @@map("walk_in_entry")
}
