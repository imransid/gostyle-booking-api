# gostyle-booking-api environment
#
#   cp .env.example .env
#
# Local `.env` is loaded first thing at boot (src/load-env.ts) and NEVER
# overrides a variable already set by the shell, docker compose or Swarm. In
# containers there is no `.env` (see .dockerignore): the environment is the
# config. Every value below shows its default; leave a line commented to keep
# it. NEVER COMMIT .env.

# ── Server ────────────────────────────────────────────────────────────
PORT=3099
NODE_ENV=development

# ── Database (required) ───────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gostyle_booking?schema=public

# ── Branch time ───────────────────────────────────────────────────────
# IANA zone of the salons. Trading days, slot minutes, reminders and journal
# entry dates are all in it. Must be a zone with no daylight saving (the
# service refuses to boot otherwise). A test salon elsewhere sets its own,
# e.g. Asia/Dhaka.
BRANCH_TIMEZONE=Asia/Dubai

# ── Auth ──────────────────────────────────────────────────────────────
# Staff tokens are verified locally with the secret gostyle-api signs them
# with. Set ONE of these; the _FILE form reads it from a mounted secret.
JWT_ACCESS_SECRET=dev-access-change-me
# JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access_secret

# Browser origins allowed to call this API, comma-separated. Empty allows the
# localhost dev ports in src/cors.ts.
# CORS_ORIGINS=https://console.example.com,https://app.example.com

# Require X-Branch-Id on every request instead of defaulting the branch.
# REQUIRE_BRANCH_HEADER=false

# ── Platform services (gRPC) ──────────────────────────────────────────
# gostyle-api: staff, services and products directories, and the journal
# ledger. In the production Swarm stack: gostyle_api:50052 (never `api`,
# which inside this stack is booking-api itself).
PLATFORM_GRPC_ADDR=platform-api:50052
# Consumer API: verifies customer (mobile) tokens.
CONSUMER_GRPC_ADDR=localhost:50051
# Channel keepalive. Raise it if the log shows GOAWAY / too_many_pings.
# GRPC_KEEPALIVE_TIME_MS=30000
# GRPC_KEEPALIVE_TIMEOUT_MS=10000

# Read the catalogues from the platform instead of the built-in fixtures.
# STAFF_FROM_PLATFORM=false
# SERVICES_FROM_PLATFORM=false
# PRODUCTS_FROM_PLATFORM=false
# Accept staff whose skills the platform has not verified yet.
# SKILLS_UNVERIFIED=false

# ── General ledger (docs/journal-integration.md) ──────────────────────
# Send each booking money movement to the platform's journal. Off: nothing is
# sent, and new rows wait as pending with their own dates until it is on.
JOURNAL_POSTING_ENABLED=false
# Only these tenant ids, comma-separated. Empty: every tenant.
JOURNAL_POSTING_TENANTS=

# ── Payments ──────────────────────────────────────────────────────────
# The checkout page a payment link points at. Empty: no link URL is issued.
# PAYMENT_LINK_BASE_URL=https://pay.example.com/booking
# Webhook signature secret (the simulated gateway's default is for dev only).
# PAYMENT_WEBHOOK_SECRET=simulated-webhook-secret

# ── Push notifications ────────────────────────────────────────────────
# PUSH_API_URL=http://push-app:3351
# PUSH_API_KEY=

# ── Mobile features ───────────────────────────────────────────────────
# MOBILE_GROUP_BOOKING=false
# MOBILE_GROUP_DEPOSIT_PERCENT=20
# MOBILE_SERIES_BOOKING=false
# MOBILE_SERIES_DEPOSIT_PERCENT=20
# MOBILE_ROUTINE_CONTRACT=false
# Count the sweeper's automatic no-shows toward pausing a routine.
# ROUTINE_COUNT_AUTO_NO_SHOWS=false
